{
  "entities": {
    "Resident": {
      "title": "Resident",
      "description": "Household and resident records of Hat Sai Thong Village Moo 7",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "idCardNumber": { "type": "string" },
        "prefix": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "birthDate": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "houseNo": { "type": "string" },
        "soi": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "occupation": { "type": "string" },
        "isHeadOfHouse": { "type": "boolean" },
        "isElderly": { "type": "boolean" },
        "isVulnerable": { "type": "boolean" },
        "vulnerabilityNote": { "type": "string" },
        "welfareBenefits": {
          "type": "array"
        },
        "medicalNote": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "houseNo", "soi"]
    },
    "GarbagePayment": {
      "title": "GarbagePayment",
      "description": "Garbage collection monthly fee payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "houseNo": { "type": "string" },
        "payerName": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "paymentDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "collectorName": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["id", "receiptNumber", "houseNo", "payerName", "amount", "month", "paymentDate"]
    },
    "FundTransaction": {
      "title": "FundTransaction",
      "description": "Village community fund ledger income and expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "recordedBy": { "type": "string" },
        "receiptRef": { "type": "string" }
      },
      "required": ["id", "date", "type", "category", "amount", "description"]
    },
    "RepairTicket": {
      "title": "RepairTicket",
      "description": "Public repair requests and grievances",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketCode": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterPhone": { "type": "string" },
        "reporterHouseNo": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "assignedTo": { "type": "string" },
        "resolutionNote": { "type": "string" },
        "estimatedCost": { "type": "number" }
      },
      "required": ["id", "ticketCode", "category", "title", "location", "status", "priority", "createdAt"]
    },
    "FacilityBooking": {
      "title": "FacilityBooking",
      "description": "Village multipurpose hall and equipment loans",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingCode": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantHouseNo": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "itemType": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "purpose": { "type": "string" },
        "status": { "type": "string" },
        "depositAmount": { "type": "number" },
        "note": { "type": "string" }
      },
      "required": ["id", "bookingCode", "applicantName", "applicantHouseNo", "itemName", "startDate", "endDate", "status"]
    },
    "VillageAnnouncement": {
      "title": "VillageAnnouncement",
      "description": "Community news and loudspeaker broadcast announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "broadcastScript": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "important": { "type": "boolean" }
      },
      "required": ["id", "title", "content", "category", "date"]
    },
    "VillageLeader": {
      "title": "VillageLeader",
      "description": "Village headman and 4 assistant headmen directory with photo and contact phone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "positionTitle": { "type": "string" },
        "phone": { "type": "string" },
        "soi": { "type": "string" },
        "houseNo": { "type": "string" },
        "responsibility": { "type": "string" },
        "imageUrl": { "type": "string" },
        "lineId": { "type": "string" }
      },
      "required": ["id", "name", "role", "positionTitle", "phone"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Test doc to verify connection to Firestore",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/residents/{residentId}": {
      "schema": "Resident",
      "description": "Household and resident records of Hat Sai Thong Village Moo 7"
    },
    "/garbagePayments/{paymentId}": {
      "schema": "GarbagePayment",
      "description": "Garbage collection monthly fee payment records"
    },
    "/fundTransactions/{transactionId}": {
      "schema": "FundTransaction",
      "description": "Village community fund ledger income and expenses"
    },
    "/repairTickets/{ticketId}": {
      "schema": "RepairTicket",
      "description": "Public repair requests and grievances"
    },
    "/bookings/{bookingId}": {
      "schema": "FacilityBooking",
      "description": "Village multipurpose hall and equipment loans"
    },
    "/announcements/{announcementId}": {
      "schema": "VillageAnnouncement",
      "description": "Community news and loudspeaker broadcast announcements"
    },
    "/leaders/{leaderId}": {
      "schema": "VillageLeader",
      "description": "Village headman and 4 assistant headmen directory"
    },
    "/test/{testId}": {
      "schema": "TestConnection",
      "description": "Test doc to verify connection to Firestore"
    }
  }
}
